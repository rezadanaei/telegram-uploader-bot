# Telegram Bot Configuration
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
BOT_USERNAME=my_movie_bot

# Channel IDs (negative numbers for private channels)
MAIN_CHANNEL_ID=-1001234567890
DATABASE_CHANNEL_ID=-1001234567891

# Admin cache TTL in seconds (default: 3600 = 1 hour)
ADMIN_CACHE_TTL=3600

# Cloudflare Configuration (added automatically via wrangler.toml)
# DB_KV: Cloudflare KV Namespace binding
# DB_D1: Cloudflare D1 Database binding
